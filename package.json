{
	"name": "cv-svelte",
	"private": true,
	"version": "1.0.41",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/generate-sitemap.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:worker": "tsc --noEmit -p worker/tsconfig.json",
		"check:build": "node scripts/check-build.mjs",
		"check:bundle": "node scripts/check-bundle.mjs",
		"lint": "eslint .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"worker:dev": "npx -y wrangler dev --config worker/wrangler.toml",
		"worker:deploy": "npx -y wrangler deploy --config worker/wrangler.toml",
		"bump": "node scripts/bump-version.js"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.7",
		"@types/node": "^22.10.5",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^26.0.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^7.2.6",
		"vitest": "^3.0.5"
	},
	"dependencies": {
		"lucide-svelte": "^0.562.0"
	}
}
