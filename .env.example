# PUBLIC VARIABLES (prefixed with PUBLIC_)
PUBLIC_APP_VERSION=$npm_package_version
PUBLIC_BASE_URL=/CV

# URL Cloudflare Worker-проксі, який тримає ключі AI-провайдерів.
# Локально: http://localhost:8787 (npm run worker:dev)
# Продакшен: https://cv-ai-proxy.<subdomain>.workers.dev
PUBLIC_AI_PROXY_URL=

# КЛЮЧІ AI ТУТ БІЛЬШЕ НЕ ЖИВУТЬ.
# Сайт статичний, тому все, що потрапляє в збірку, видно у DevTools — саме так
# і вичерпувалися ліміти. Ключі тепер секрети воркера:
#   npx wrangler secret put GEMINI_API_KEY     --config worker/wrangler.toml
#   npx wrangler secret put GROQ_API_KEY       --config worker/wrangler.toml
#   npx wrangler secret put SAMBANOVA_API_KEY  --config worker/wrangler.toml
# Для локального `npm run worker:dev` — файл worker/.dev.vars (див. worker/README.md).
